# Laya model (public, Apache-2.0). Alternatives: convaiinnovations/laya
MODEL_NAME=convaiinnovations/laya-typed-decisions
# Optional: model is public; a token only raises Hugging Face rate limits
HF_TOKEN=
# Noul (yes/no) answer thresholds: >= TRUE_AT_OR_ABOVE -> true, < FALSE_BELOW -> false, between -> unsure
NOUL_TRUE_AT_OR_ABOVE=0.6
NOUL_FALSE_BELOW=0.4
# Benchmark only (free key: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
